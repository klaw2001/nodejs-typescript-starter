# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
TZ=UTC
MODE=development
PORT=8000
API_BASEURL=http://localhost:8000/api
FRONTEND_BASEURL=http://localhost:3000
# Comma separated list of origins allowed by CORS (empty = no cross-origin requests)
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL). Matches docker-compose.yml: `docker compose up -d db`
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# -----------------------------------------------------------------------------
# Auth
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-64-hex-chars
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-64-hex-chars
# Session hard limit: user must log in again after this
JWT_REFRESH_TOKEN_EXPIRE=12h
# Failed logins before the account is locked, and lock duration
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_EXPIRE_MINUTES=10

# 32 byte key (64 hex chars) / 16 byte iv (32 hex chars), used for aes-256-cbc encrypt()/decrypt()
ENCRYPT_KEY=change-me-64-hex-chars
ENCRYPT_IV=change-me-32-hex-chars
# Secret used to sign short lived file URLs
FILE_URL_SECRET=change-me-64-hex-chars

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
STORAGE_PATH=storage
UPLOAD_MAX_MB=25

# -----------------------------------------------------------------------------
# Mail (SMTP). Leave MAIL_HOST empty to log mails instead of sending
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Starter App <no-reply@example.com>"

# -----------------------------------------------------------------------------
# SMS for OTP. console = log OTP to server logs (development)
# -----------------------------------------------------------------------------
SMS_PROVIDER=console

# -----------------------------------------------------------------------------
# Scheduled cleanup job (expired OTPs, old notifications). Empty value disables it
# -----------------------------------------------------------------------------
CLEANUP_CRON=0 3 * * *
CLEANUP_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Seed (npm run db:seed). The seeded super admin must change the password on
# first login. Demo user: npm run db:seed:demo (development only)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_DEMO_PASSWORD=change-me-Demo1
